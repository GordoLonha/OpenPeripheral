{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenPeripheral",
  "version": "0.4.1",
  "identifier": "dev.openperipheral.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenPeripheral",
        "width": 1280,
        "height": 780,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 980,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Controle aberto de periféricos",
    "publisher": "OpenPeripheral",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "copyright": "OpenPeripheral contributors",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEMjcxRTJDRDg1MzMxODgKUldTSU1WUFlMQjRualhnajRrbkxUODFvYk9tYWJlRjhJZHJPWEFGZW53T1hBYWpPL1dHVGJCUmYK",
      "endpoints": [
        "https://github.com/GordoLonha/OpenPeripheral/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
